# Copie para .env e preencha. O .env está no .gitignore e nunca vai para o git.

# Chave da API da Anthropic (console.anthropic.com > API Keys).
ANTHROPIC_API_KEY=

# Provedor do assistente: "anthropic" (padrão, gera os números publicados) ou "ollama".
PROVEDOR=anthropic

# Só para o provedor ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:7b
