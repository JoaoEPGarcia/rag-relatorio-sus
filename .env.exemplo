# Copie para .env e preencha. O .env está no .gitignore e nunca vai para o git.

# Chave do Gemini (aistudio.google.com/apikey), criada na conta Google do Google AI Pro.
GEMINI_API_KEY=

# "gratuito" (plano gratuito, sem custo) ou "creditos-ai-pro" (projeto pré-pago pago pelos
# créditos mensais do Google AI Pro, via Google Developer Program). O wizard preenche.
GEMINI_PLANO=gratuito

# Provedor do assistente: "gemini" (padrão, gera os números publicados) ou "ollama" (local).
PROVEDOR=gemini

# Só para o provedor ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:7b
